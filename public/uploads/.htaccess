# Deny script execution and directory listing under public uploads.
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

Options -Indexes

<FilesMatch "\.(?i:php\d*|pht|phtml|phps|phar|cgi|pl|py|asp|aspx|sh|shtml|htaccess|htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Uploaded markup must never run script on the app origin (still renders fine via <img>).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(?i:svgz?|html?|xhtml|xml)$">
        Header set Content-Security-Policy "sandbox"
        Header set Content-Disposition "attachment"
    </FilesMatch>
</IfModule>
