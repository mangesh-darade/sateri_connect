#--------------------------------------------------------------------
# WhatsApp Automation Platform — Environment Template
#--------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for your environment:
#   cp .env.example .env
#
# Generate an encryption key:
#   php spark key:generate
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# development | testing | production
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Must end with a trailing slash.
# Prefer DocumentRoot = public/. If DocumentRoot is project root (Plesk/nginx):
#   - keep root index.php
#   - run: php spark webroot:publish
#   - set app.indexPage = 'index.php' until rewrite works
#
# Local WAMP example:
app.baseURL = 'http://localhost/sateri_connect/public/'
app.forceGlobalSecureRequests = false
app.indexPage = ''
#
# Production example (androidtestings):
# CI_ENVIRONMENT = production
# app.baseURL = 'https://androidtestings.elintpos.in/'
# app.forceGlobalSecureRequests = true
# app.indexPage = 'index.php'
# app.CSPEnabled = false
# app.appTimezone = UTC

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Connection credentials are NOT in .env.
# Edit tenant DBs only in: app/Config/Database.php → applyBySubdomain()
# Optional CLI force which switch case to use:
# database.tenant = localhost
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Required for encrypted settings (Cheerio API key, secrets).
# Run: php spark key:generate
encryption.key =

#--------------------------------------------------------------------
# JWT (REST API)
#--------------------------------------------------------------------
# HMAC secret for API Bearer tokens. Use a long random string.
JWT_SECRET =

#--------------------------------------------------------------------
# SESSION / LOGGER (optional overrides)
#--------------------------------------------------------------------
# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# logger.threshold = 4

#--------------------------------------------------------------------
# CHEERIO DIRECT API (optional — prefer Settings UI / installer)
#--------------------------------------------------------------------
# Credentials are normally stored encrypted in the `settings` table.
# Uncomment only if you need env-level defaults for local testing.
#
# CHEERIO_API_KEY =
# CHEERIO_WEBHOOK_VERIFY_TOKEN =
# CHEERIO_WEBHOOK_SECRET =
# CHEERIO_BASE_URL = https://newprod.api.cheerio.in/direct-apis
