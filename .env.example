#--------------------------------------------------------------------
# WhatsApp Automation Platform — Environment Template
#--------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for your environment:
#   cp .env.example .env
#
# Generate an encryption key:
#   php spark key:generate
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# development | testing | production
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Must end with a trailing slash. Point DocumentRoot at /public.
app.baseURL = 'http://localhost/APIWA/public/'
app.forceGlobalSecureRequests = false
app.indexPage = ''
# app.CSPEnabled = false
# app.appTimezone = UTC

#--------------------------------------------------------------------
# DATABASE (MySQL via XAMPP)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = apiwa
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Required for encrypted settings (Cheerio API key, secrets).
# Run: php spark key:generate
encryption.key =

#--------------------------------------------------------------------
# JWT (REST API)
#--------------------------------------------------------------------
# HMAC secret for API Bearer tokens. Use a long random string.
JWT_SECRET =

#--------------------------------------------------------------------
# SESSION / LOGGER (optional overrides)
#--------------------------------------------------------------------
# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# logger.threshold = 4

#--------------------------------------------------------------------
# CHEERIO DIRECT API (optional — prefer Settings UI / installer)
#--------------------------------------------------------------------
# Credentials are normally stored encrypted in the `settings` table.
# Uncomment only if you need env-level defaults for local testing.
#
# CHEERIO_API_KEY =
# CHEERIO_WEBHOOK_VERIFY_TOKEN =
# CHEERIO_WEBHOOK_SECRET =
# CHEERIO_BASE_URL = https://newprod.api.cheerio.in/direct-apis
